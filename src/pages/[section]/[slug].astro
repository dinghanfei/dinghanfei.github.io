---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection, render, type CollectionEntry } from "astro:content";
import profile from "../../data/profile.json";

type Project = CollectionEntry<"projects">;

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.map((project) => ({
    params: {
      section: project.data.section === "research" ? "research" : "projects",
      slug: project.id,
    },
    props: { project },
  }));
}

const { project } = Astro.props as { project: Project };
const { Content } = await render(project);
const isResearch = project.data.section === "research";
const backHref = isResearch ? "/#research" : "/#projects";
const backLabel = isResearch ? "research" : "projects";
---

<BaseLayout title={`${project.data.title} | ${profile.name}`} description={project.data.summary}>
  <header class="site-header">
    <a class="brand" href="/#about" aria-label={`${profile.name} home`}>
      <span class="brand-mark">
        <img src={profile.brandIcon} alt="" aria-hidden="true" />
      </span>
      <span>{profile.name}</span>
    </a>
    <nav class="nav-links" aria-label="Primary navigation">
      <a href="/#about">About</a>
      <a href="/#cv">CV</a>
      <a href="/#projects">Project</a>
      <a href="/#research">Research</a>
      <button class="theme-toggle" type="button" aria-label="Toggle color theme">
        <span class="sun" aria-hidden="true">☼</span>
        <span class="moon" aria-hidden="true">◐</span>
      </button>
    </nav>
  </header>

  <main>
    <article class="project-detail page-section">
      <a class="back-link" href={backHref}>← Back to {backLabel}</a>
      <div class="project-detail-hero reveal">
        <div>
          <p class="eyebrow">{project.data.year}</p>
          <h1>{project.data.title}</h1>
          {project.data.subtitle && <p class="project-detail-subtitle">{project.data.subtitle}</p>}
          <p class="lead">{project.data.summary}</p>
          <div class="tag-row">
            {project.data.tags.map((tag) => <span>{tag}</span>)}
          </div>
        </div>
        <img class="project-detail-image" src={project.data.image.src} alt={project.data.image.alt} />
      </div>

      <section class="project-story reveal">
        <Content />
        {project.data.links.length > 0 && (
          <section class="story-section">
            <h2>Links</h2>
            <div class="project-links">
              {project.data.links.map((link) => (
                <a href={link.href} target="_blank" rel="noreferrer">{link.label}</a>
              ))}
            </div>
          </section>
        )}
      </section>
    </article>
  </main>
</BaseLayout>
